{
  "name": "dandori-academy",
  "private": true,
  "version": "0.45.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude '**/*.levels.test.ts' --exclude '**/node_modules/**'",
    "build:docs": "tsc --noEmit && vite build --outDir docs --emptyOutDir",
    "balance": "VITE_BALANCE=1 vitest run src/game/world/balance.report.test.ts -u",
    "board:collect": "vite build --ssr scripts/collect-board.ts --outDir .board-build --emptyOutDir --logLevel warn && node .board-build/collect-board.js",
    "paces": "VITE_PACES=1 vitest run src/game/modes/challengePace.report.test.ts",
    "test:levels": "vitest run levels.test",
    "test:all": "vitest run",
    "e2e": "vite build && playwright test",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs",
    "desktop": "npm run build && electron desktop/dev.cjs",
    "deploy:web": "npm run build && wrangler pages deploy --branch main",
    "deploy:board": "wrangler deploy --config worker/wrangler.toml",
    "deploy:itch": "npm run build && node scripts/push-itch.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@electron/packager": "^20.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.166.0"
  }
}
